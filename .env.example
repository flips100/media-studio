# Local: leave empty — Vite proxies /api and /files to http://localhost:8787
# Production (GitHub Pages): set to your Render Ice API origin, no trailing slash
# Example: https://media-studio-api.onrender.com
VITE_API_URL=

# Optional build-time base path (CI sets /media-studio/ for GitHub Pages)
# VITE_BASE=/media-studio/
